# Copy to .env and fill in. With DEMO_MODE=true nothing else is needed; otherwise you need a
# key for each provider your traders' models use, plus TAVILY_API_KEY for the researcher.
DEMO_MODE=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional: live prices from Massive. Without it, prices come from the built-in simulator.
MASSIVE_API_KEY=

# Notifications: auto picks Pushover, then ntfy, then Slack, else the log (or: none)
NOTIFY_CHANNEL=auto
PUSHOVER_USER=
PUSHOVER_TOKEN=
NTFY_URL=
SLACK_WEBHOOK_URL=

# Optional: other model providers
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=

# Models for new traders: one per provider, and/or per-trader overrides
USE_MANY_MODELS=false
TRADER_MODELS=

# Scheduler (RUN_EVERY_N_MINUTES defaults to 60, or 3 in demo mode)
RUN_EVERY_N_MINUTES=
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
RUN_TIMEOUT_SECONDS=900
RUN_RETRIES=2

# Database: empty means SQLite in the data directory. Local Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
AUTO_MIGRATE=true

# Signs the traders' MCP tokens. Required outside local development.
GAUNTLET_SECRET_KEY=
# Where the trading floor reaches the API (which hosts the account and market MCP servers)
API_BASE_URL=http://127.0.0.1:8000

# Optional: where the SQLite database and researcher memory live (default: ./data)
GAUNTLET_DATA_DIR=

# Admin access: a static bearer token, and/or Supabase users by email (a JSON list)
ADMIN_API_TOKEN=
ADMIN_EMAILS=[]
ADMIN_RATE_LIMIT=60/minute
ADMIN_AUTH_FAILURE_LIMIT=10/minute

# Supabase Auth and Realtime. Locally, `npx supabase status` prints the URL and anon key.
# SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=
SUPABASE_ANON_KEY=

# docker compose only: the same things as containers reach them on this machine
# COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
COMPOSE_DATABASE_URL=
SUPABASE_INTERNAL_URL=
