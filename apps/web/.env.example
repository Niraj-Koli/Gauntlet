# Read by the Next.js server at runtime (not baked into the build).
# Where it reaches the Gauntlet API (it forwards /api/v1 there)
API_URL=http://127.0.0.1:8000

# Optional: Supabase for live updates (Realtime) and admin sign-in (Auth).
# Without these the dashboard polls every few seconds and admin uses ADMIN_API_TOKEN.
# Local stack: `npx supabase status` prints both values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
